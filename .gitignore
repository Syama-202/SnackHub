# Old code from the uploaded zip (frontend, Snack-Website, Food-Delivery-Microservices),
# kept in folder/ for reference only, never committed.
# folder/Snack-Website/.env holds real secrets (doc 3, P0-1): rotate them and keep them out of git.
/folder/

# Local tool settings
/.claude/
file.txt

# Dependencies, builds, logs
node_modules/
dist/
dist-admin/
coverage/
*.log

# Secrets: only the example files are committed
.env
.env.*
!.env.example

# Large media originals stay in a private bucket (doc 22.8)
assets/raw/

# Uploaded verification documents: private storage, never in git
backend/storage/

# Markdown stays local (CLAUDE.md, docs, test notes); only README files are committed
*.md
!README.md
