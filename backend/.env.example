# Copy to backend/.env, or run `npm run setup` at the repo root. Ignored by git.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# the build running, shown on each recorded error (for example a git commit hash)
# RELEASE=dev
# the API docs at /api/docs (on by default outside production)
# API_DOCS=true
# Exact origins allowed to call the API with credentials (doc 16.2)
CORS_ORIGINS=http://localhost:5180,http://localhost:5181
DB_HOST=127.0.0.1
DB_PORT=3307
# Owns DDL on every module schema; used only by migrations and the seed
DB_MIGRATOR_USER=sh_migrator
DB_MIGRATOR_PASSWORD=change-me
# Each module connects as its own user (sh_identity, sh_catalog, ...) with this local password
DB_MODULE_PASSWORD=change-me
# Signs our own access tokens. Random, at least 32 characters (npm run setup makes one)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Google sign-in: the Web client ID from Google Cloud Console (no client secret is used)
GOOGLE_CLIENT_ID=
# Minutes an access token lasts, days a refresh cookie lasts
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# true behind HTTPS; false for http://localhost
COOKIE_SECURE=false

# Admin console (doc 16.3). Hosts (host:port) allowed to reach /api/v1/admin; others get 404.
# Outside production the console's X-SnackHub-Host: admin header is also accepted.
ADMIN_HOSTS=localhost:5181
ADMIN_CONSOLE_URL=http://localhost:5180/admin.html
ADMIN_ACCESS_MINUTES=10
ADMIN_SESSION_HOURS=8
# 32 random bytes, base64url; npm run setup fills it in. Encrypts TOTP secrets; separate keys
# for document numbers, one-time codes and signed file links are derived from it.
MFA_KEY=

# Sign-up and sign-in for customers, sellers and riders. Links in emails point at APP_URL.
APP_URL=http://localhost:5180
# Roles that must use an authenticator app (admin and reviewer always do)
MFA_REQUIRED_ROLES=admin,reviewer,seller
TERMS_VERSION=2026-03
# true checks new passwords against Have I Been Pwned (only a 5-character hash prefix is sent)
PASSWORD_BREACH_CHECK=false

# Email with nodemailer. Left out in development, every message is saved as an .eml file in
# MAIL_DIR (open it in any mail app; nothing is sent). Set SMTP_HOST (and the rest) to send
# for real through your provider; in production that is the only option.
# MAIL_TRANSPORT=file
MAIL_DIR=storage/mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=SnackHub (demo) <no-reply@snackhub.test>
# Text messages: off ('') until a provider is set. Left out in development, each text is saved
# with the emails (dev-mail). For real texts: SMS_PROVIDER=twilio and the three TWILIO_ values.
# SMS_PROVIDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Verification documents: private folder outside every public path (relative to backend/)
STORAGE_DIR=storage/private
# ClamAV daemon for upload scanning; empty stores uploads as "not scanned"
CLAMAV_HOST=
CLAMAV_PORT=3310
# The outbox relay (emails, texts) and the document-expiry job run inside the API. Set false
# when a scheduler runs `npm run jobs` instead.
# RUN_JOBS=true

# Redis (npm run redis:up starts it in Docker on 127.0.0.1:6380): shared rate-limit counters
# and live updates across API processes. Unset in development means redis://127.0.0.1:6380;
# production must set it. While Redis is down each process counts on its own.
# REDIS_URL=redis://127.0.0.1:6380
# Every /api/v1 request from one IP address per minute, on top of the per-route limits
# RATE_LIMIT_IP_PER_MIN=600

# Place search for the address map pin: a Nominatim-compatible server. Unset: the public
# OpenStreetMap Nominatim in development (light use only, one request a second), off in tests
# and production unless you set your own. The contact (email or URL) goes in the User-Agent.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_CONTACT=you@example.com

# Online payment: PhonePe Standard Checkout, SANDBOX ONLY (the app has no production address).
# From the PhonePe Business Dashboard (Test Mode) > Developer Settings. Empty: pay on delivery only.
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# Webhook (Dashboard > Developer Settings > Webhook, Test Mode on), pointing at
# https://<your tunnel>/api/v1/webhooks/phonepe with these credentials:
# PHONEPE_WEBHOOK_USERNAME=
# PHONEPE_WEBHOOK_PASSWORD=
# Minutes the customer has to pay (5 to 60)
# PAYMENT_WINDOW_MIN=15

# Push notifications (phone and desktop alerts). Make a key pair with
#   npx web-push generate-vapid-keys
# and paste both keys here. Empty keeps push off; the in-app inbox works either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# how a push service can reach whoever runs this server (mailto: or https:)
# VAPID_SUBJECT=mailto:you@example.com
