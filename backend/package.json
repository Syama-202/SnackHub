{
  "name": "snackhub-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SnackHub backend: Express modular monolith (Identity, Catalog, Order, Dispatch, Payment, Notify) on MySQL 8",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file=.env scripts/migrate.js latest",
    "migrate:down": "node --env-file=.env scripts/migrate.js rollback",
    "migrate:status": "node --env-file=.env scripts/migrate.js status",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "vitest run",
    "db:local": "node scripts/local-db-init.js",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "db:hosted": "node --env-file=.env.production scripts/hosted-db-init.js",
    "migrate:hosted": "node --env-file=.env.production scripts/migrate.js latest",
    "seed:hosted": "node --env-file=.env.production scripts/seed.js",
    "create-admin:hosted": "node --env-file=.env.production scripts/create-admin.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "backup:hosted": "node --env-file=.env.production scripts/backup.js",
    "jobs": "node --env-file=.env scripts/jobs.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.5.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.2.1",
    "otplib": "^12.0.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "swagger-ui-dist": "5.33.3",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
