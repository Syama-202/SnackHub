# One API base pointing at the gateway (doc 5.1). Public values only.
VITE_API_URL=/api/v1
# "true" serves every /api/v1 call from the in-browser MSW mock (Phase 1).
VITE_USE_MOCKS=true
# Public values only. The Razorpay secret never reaches the browser.
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
