# Copy to frontend/.env.local (ignored by git). Every VITE_ value ends
# up in the browser bundle.
# One API base pointing at the gateway (doc 5.1).
VITE_API_URL=/api/v1
# The one-tap demo runs on an in-browser mock (MSW) that answers only the demo accounts.
# Development starts it unless this is "false". A production build starts it only once a
# visitor picks a demo account, or on every page when this is "true" (a demo-only site).
VITE_USE_MOCKS=true
# Google sign-in for customers: the same Web client ID as GOOGLE_CLIENT_ID in backend/.env.
# Left empty, the customer sign-in page offers email and password only.
VITE_GOOGLE_CLIENT_ID=
# Where the "Admin access" card on /join points (the admin console is its own app)
VITE_ADMIN_CONSOLE_URL=http://localhost:5181

# Optional, for npm run assets:generate only (never sent to the browser): a Hugging Face
# read token from https://huggingface.co/settings/tokens. Without it the free public model
# stops after a few images.
HF_TOKEN=
