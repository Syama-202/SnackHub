{
  "name": "snackhub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.js",
    "build": "vite build && vite build --config vite.admin.config.js",
    "build:web": "vite build",
    "build:admin": "vite build --config vite.admin.config.js",
    "preview": "vite preview",
    "assets:manifest": "node scripts/asset-manifest.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:process": "node scripts/process-images.mjs",
    "assets:icons": "node scripts/brand-icons.mjs",
    "assets:generate": "node --env-file-if-exists=.env.local scripts/generate-images.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.8.0",
    "@reduxjs/toolkit": "^2.13.0",
    "gsap": "^3.15.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.60.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "msw": "^2.11.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
