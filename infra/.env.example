# Copy to infra/.env (or run `npm run setup` at the repo root, which writes random local
# passwords into infra/.env and backend/.env without printing them). Ignored by git.
MYSQL_ROOT_PASSWORD=change-me-root
MIGRATOR_PASSWORD=change-me-migrator
MODULE_DB_PASSWORD=change-me-modules
MINIO_ROOT_USER=snackhub
MINIO_ROOT_PASSWORD=change-me-minio
