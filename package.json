{
  "name": "snackhub",
  "private": true,
  "version": "0.2.0",
  "description": "SnackHub monorepo: frontend (React), backend (Express modular monolith), shared rules, local infrastructure",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "db:local": "npm --prefix backend run db:local",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=50",
    "migrate": "npm --prefix backend run migrate",
    "migrate:down": "npm --prefix backend run migrate:down",
    "migrate:status": "npm --prefix backend run migrate:status",
    "seed": "npm --prefix backend run seed",
    "create-admin": "npm --prefix backend run create-admin --",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build",
    "jobs": "npm --prefix backend run jobs",
    "dev:admin": "npm --prefix frontend run dev:admin"
  }
}
